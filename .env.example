# 复制为 .env 后填写。.env 已被 .gitignore 排除，绝不会进仓库。
# 什么 key 都不填也能启动：会自动使用 mock 模型，链路可跑通，但答案是占位内容。

# deepseek | openai | mock | auto（auto = 有 key 用 deepseek，没有用 mock）
LLM_PROVIDER=auto

# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 任意 OpenAI 兼容端点（通义、硅基流动、智谱等），配了就用这个
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 服务端口
PORT=8787
# 教师后台令牌；留空则自动生成并写入 data/admin-token.txt
ADMIN_TOKEN=

# 每名学生每小时防连刷上限的默认值（可被课程配置和单个学生覆盖）
RATE_LIMIT_PER_HOUR=10

# 扫描版 PDF 取字方式：auto（默认）/ local（本机 OCR）/ vision（多模态模型）
# auto 的判断顺序：配了下面的 OCR_* → 用视觉模型；否则 macOS/Linux 用本机 OCR
OCR_BACKEND=auto

# 视觉 OCR 专用（和聊天模型分开配，互不影响）
# 例：阿里云百炼 qwen-vl-max / 智谱 glm-4v-plus / OpenAI gpt-4o
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
