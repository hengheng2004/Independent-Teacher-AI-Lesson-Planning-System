{
  "name": "teacher-ai-suite",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "独立教师 AI 工作台：建课、传材料、备课对话、质检、学生答疑助教",
  "keywords": [
    "tutoring",
    "rag",
    "education",
    "llm",
    "teaching-assistant"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-packs.mjs",
    "build:vectors": "node scripts/build-vectors.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/smoke.mjs && node test/http.mjs",
    "check": "node scripts/check-packs.mjs",
    "eval": "node scripts/eval-retrieval.mjs",
    "add-student": "node scripts/add-student.mjs",
    "demo": "npm run build && node src/server.js",
    "watch": "node scripts/watch.mjs",
    "docs": "node scripts/build-guide.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
